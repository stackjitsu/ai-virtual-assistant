{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delegated Task Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "goal",
        "acceptanceCriteria",
        "context",
        "owner",
        "allowedPaths",
        "contractRefs",
        "invariants",
        "checks",
        "dependencies",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "claimed", "blocked", "completed"] },
        "goal": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "context": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "contractRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "invariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "format",
              "lint",
              "static",
              "unit",
              "contract",
              "fuzz-smoke",
              "fuzz-full"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocker": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": { "required": ["blocker", "nextAction"] }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": {
            "properties": { "evidence": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
