diff --git c/internal/chat/rating.go w/internal/chat/rating.go
new file mode 100644
index 0000000..8a49e35
--- /dev/null
+++ w/internal/chat/rating.go
@@ -0,0 +1,120 @@
+package chat
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const ratingAttemptsPerMinute = 10
+
+// Rating is the single canonical, revisable record belonging to a conversation.
+type Rating struct {
+	ConversationID string    `json:"-"`
+	Value          int       `json:"rating"`
+	Comment        string    `json:"comment"`
+	RatedAt        time.Time `json:"rated_at"`
+}
+
+var ErrRatingRequiresTurn = errors.New("rating requires a completed turn")
+
+func canonicalRatingComment(raw string) (string, error) {
+	comment := strings.TrimSpace(raw)
+	if comment != "" && !validText(comment, 1000, 2000) {
+		return "", ErrInvalid
+	}
+	return comment, nil
+}
+
+func decodeRatingRequest(b []byte) (int, string, error) {
+	var body struct {
+		Rating  json.RawMessage `json:"rating,omitempty"`
+		Comment json.RawMessage `json:"comment,omitempty"`
+	}
+	if len(b) > 4096 || strictJSON(b, &body) != nil || len(body.Rating) != 1 || body.Rating[0] < '1' || body.Rating[0] > '5' {
+		return 0, "", ErrInvalid
+	}
+	comment := ""
+	if len(body.Comment) != 0 {
+		if string(body.Comment) == "null" || json.Unmarshal(body.Comment, &comment) != nil || len(body.Comment) == 0 || body.Comment[0] != '"' {
+			return 0, "", ErrInvalid
+		}
+	}
+	canonical, err := canonicalRatingComment(comment)
+	if err != nil {
+		return 0, "", err
+	}
+	return int(body.Rating[0] - '0'), canonical, nil
+}
+
+func validateRating(r Rating) error {
+	if !idPattern.MatchString(r.ConversationID) || r.Value < 1 || r.Value > 5 || r.RatedAt.IsZero() || !utf8.ValidString(r.Comment) {
+		return ErrInvalid
+	}
+	canonical, err := canonicalRatingComment(r.Comment)
+	if err != nil || canonical != r.Comment {
+		return ErrInvalid
+	}
+	return nil
+}
+
+func (s *server) rateRating(w http.ResponseWriter, r *http.Request) bool {
+	peer, now := peerAddress(r), time.Now()
+	s.mu.Lock()
+	window := s.window(peer, now)
+	allowed := window.ratings < ratingAttemptsPerMinute
+	if allowed {
+		window.ratings++
+	}
+	s.rates[peer] = window
+	s.mu.Unlock()
+	if !allowed {
+		apiError(w, 429, "rate_limited")
+	}
+	return allowed
+}
+
+func (s *server) rateConversation(w http.ResponseWriter, r *http.Request) {
+	if !s.rateRating(w, r) {
+		return
+	}
+	if r.URL.RawQuery != "" {
+		apiError(w, 400, "invalid_request")
+		return
+	}
+	media := struct {
+		Rating  json.RawMessage `json:"rating,omitempty"`
+		Comment json.RawMessage `json:"comment,omitempty"`
+	}{}
+	// Reuse the existing 4 KiB media/body/strict-JSON gate; the raw
+	// rating token is then checked for the exact integer literal 1–5.
+	if !decodeBody(w, r, 4096, &media) {
+		return
+	}
+	b, _ := json.Marshal(media)
+	value, comment, err := decodeRatingRequest(b)
+	if err != nil {
+		apiError(w, 400, "invalid_request")
+		return
+	}
+	c, ok := s.authorize(w, r)
+	if !ok {
+		return
+	}
+	commitCtx, cancel := context.WithTimeout(context.WithoutCancel(r.Context()), 3*time.Second)
+	defer cancel()
+	stored, err := s.store.SaveRating(commitCtx, Rating{c.ID, value, comment, time.Now().UTC()})
+	if err != nil {
+		if errors.Is(err, ErrRatingRequiresTurn) {
+			apiError(w, 409, "rating_requires_turn")
+		} else {
+			apiError(w, 503, "storage_unavailable")
+		}
+		return
+	}
+	writeJSON(w, 200, stored)
+}
diff --git c/internal/chat/rating_store.go w/internal/chat/rating_store.go
new file mode 100644
index 0000000..8282fbe
--- /dev/null
+++ w/internal/chat/rating_store.go
@@ -0,0 +1,69 @@
+package chat
+
+import (
+	"context"
+	"time"
+)
+
+// One statement decides eligibility, deduplication, replacement and the row
+// returned to the caller. Both adapters execute exactly this statement; a
+// detached read cannot substitute for the serialized write decision.
+// Fixed-width UTC nanoseconds make lexical comparison safe across processes.
+const saveRatingSQL = `INSERT INTO ratings(conversation_id,rating,comment,rated_at)
+ SELECT ?,?,?,? WHERE EXISTS (
+ SELECT 1 FROM turns WHERE conversation_id=? AND status IN ('answered','needs_clarification'))
+ ON CONFLICT(conversation_id) DO UPDATE SET
+ rating=excluded.rating, comment=excluded.comment,
+ rated_at=CASE WHEN ratings.rating=excluded.rating AND ratings.comment=excluded.comment THEN ratings.rated_at
+ WHEN excluded.rated_at>ratings.rated_at THEN excluded.rated_at
+ WHEN substr(ratings.rated_at,21,9)='999999999' THEN strftime('%Y-%m-%dT%H:%M:%S',ratings.rated_at,'+1 second')||'.000000000Z'
+ ELSE substr(ratings.rated_at,1,20)||printf('%09d',CAST(substr(ratings.rated_at,21,9) AS INTEGER)+1)||'Z' END
+ RETURNING conversation_id,rating,comment,rated_at`
+
+func ratingTimestamp(t time.Time) string {
+	return t.UTC().Format("2006-01-02T15:04:05.000000000Z")
+}
+
+func decodeRatingRow(v []any) (Rating, error) {
+	if len(v) != 4 {
+		return Rating{}, ErrUnavailable
+	}
+	id, a := textCell(v[0])
+	n, b := v[1].(int64)
+	comment, c := textCell(v[2])
+	when, d := timeCell(v[3])
+	if !a || !b || !c || !d || n < 1 || n > 5 {
+		return Rating{}, ErrUnavailable
+	}
+	out := Rating{id, int(n), comment, when}
+	if validateRating(out) != nil {
+		return Rating{}, ErrUnavailable
+	}
+	return out, nil
+}
+
+// SaveRating is atomic on SQLite and Turso. A failed remote response may
+// conceal a committed update; never infer a successful replacement from a
+// later read that could belong to another concurrent operation.
+func (s *SQLStore) SaveRating(ctx context.Context, proposed Rating) (Rating, error) {
+	if validateRating(proposed) != nil {
+		return Rating{}, ErrInvalid
+	}
+	r, err := s.query(ctx, saveRatingSQL, proposed.ConversationID, proposed.Value, proposed.Comment, ratingTimestamp(proposed.RatedAt), proposed.ConversationID)
+	if err != nil {
+		return Rating{}, ErrUnavailable
+	}
+	if len(r.rows) == 1 {
+		stored, err := decodeRatingRow(r.rows[0])
+		if err != nil || stored.ConversationID != proposed.ConversationID {
+			return Rating{}, ErrUnavailable
+		}
+		return stored, nil
+	}
+	if len(r.rows) != 0 {
+		return Rating{}, ErrUnavailable
+	}
+	// A zero-row conditional INSERT is definitive for this statement: there
+	// was no eligible completed turn at the atomic decision point.
+	return Rating{}, ErrRatingRequiresTurn
+}
diff --git c/internal/chat/rating_test.go w/internal/chat/rating_test.go
