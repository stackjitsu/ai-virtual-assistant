# Documentation only: the application does not automatically load this file.
# Export chosen values in your runtime shell; never put secrets in browser assets.
LISTEN_ADDR=127.0.0.1:8080
ASSISTANT_ORIGIN=http://127.0.0.1:8080
STORE_MODE=sqlite
SQLITE_PATH=./data/assistant.db
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional complete chat-completions URL; blank keeps the OpenAI default.
OPENAI_BASE_URL=
# Future staging only, AFTER the backend/widget demo-policy change is integrated:
# ASSISTANT_PUBLIC_DEMO=true
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# OPENAI_MODEL=gemini-2.5-flash-lite
# Render requires STORE_MODE=turso and explicit actual HTTPS origins; see
# docs/deployment/render-staging.md. Never copy the local defaults into public staging.
# Render supplies PORT; the Docker command maps it to LISTEN_ADDR=0.0.0.0:$PORT.
# Provider key and Turso URL/token must be supplied separately through a secret store.
# Remote mode is opt-in; never test against a live database by default.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Explicit parent origins for embedding (space-separated, no paths).
WIDGET_PARENT_ORIGINS="http://localhost:8080 http://127.0.0.1:8080"
